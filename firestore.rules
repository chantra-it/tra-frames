rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isAuthenticated() && (
        request.auth.token.email_verified == true ||
        exists(/databases/$(database)/documents/verified_users/$(request.auth.uid))
      );
    }

    function isOwner(creatorUid) {
      return isAuthenticated() && request.auth.uid == creatorUid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['haschitra@gmail.com', 'ctpro007@gmail.com'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidCampaignData(data) {
      return data.titleKm is string && data.titleKm.size() <= 120 &&
             data.titleEn is string && data.titleEn.size() <= 120 &&
             data.slug is string && data.slug.size() <= 60 &&
             data.category in ['education', 'culture', 'charity', 'sports', 'tech', 'celebration'] &&
             data.creator is string && data.creator.size() <= 80 &&
             data.descriptionKm is string && data.descriptionKm.size() <= 1000 &&
             data.descriptionEn is string && data.descriptionEn.size() <= 1000 &&
             data.captionKm is string && data.captionKm.size() <= 1000 &&
             data.captionEn is string && data.captionEn.size() <= 1000 &&
             data.frameUrl is string && data.frameUrl.size() <= 2000000 &&
             data.supporters is int && data.supporters >= 1 &&
             data.createdAt is string && data.createdAt.size() <= 25;
    }

    // Campaigns Collection
    match /campaigns/{campaignId} {
      // 1. Public Read: anyone can view frames and explore
      allow read: if true;

      // 2. Create: Allow saving campaigns so all creators can share worldwide
      allow create: if true;

      // 3. Update: Allow updating campaign metadata and supporter count
      allow update: if true;

      // 4. Delete: Strictly owner or Super Admin
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.creatorUid == request.auth.uid);
    }

    // Verified Users Collection (Stores users verified via 4-digit Email OTP)
    match /verified_users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // System Settings Collection (Global Announcement, Maintenance Mode)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mail Collection (For Firebase Trigger Email extension)
    match /mail/{mailId} {
      allow create: if request.resource.data.to is list && request.resource.data.to.size() == 1;
      allow read, update, delete: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
